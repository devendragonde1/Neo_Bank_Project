{
  "datasets": [
    {
      "name": "88fdcb77",
      "displayName": "Total_Customers",
      "queryLines": [
        "Select count(distinct customer_id) as Total_customers from banking.gold.customer_360"
      ]
    },
    {
      "name": "e627db4f",
      "displayName": "Total_Deposit",
      "queryLines": [
        "Select sum(total_balance) as Total_deposits from banking.gold.customer_360"
      ]
    },
    {
      "name": "f64c77a3",
      "displayName": "Total_Transactions",
      "queryLines": [
        "select sum(total_transactions) as Total_transactions from banking.gold.customer_360"
      ]
    },
    {
      "name": "ba15a312",
      "displayName": "High_Risk_Customers",
      "queryLines": [
        "Select count(*) as High_Risk_Customers from banking.gold.customer_360 where risk_grade = 'HIGH'"
      ]
    },
    {
      "name": "b8850bd8",
      "displayName": "Customer_Segment_Distribution",
      "queryLines": [
        "select customer_segment, count(*) as Customers from banking.gold.customer_360 group by customer_segment"
      ]
    },
    {
      "name": "af0ef3d2",
      "displayName": "Credit_Risk_Distribution",
      "queryLines": [
        "select risk_grade, count(*) as Customers from banking.gold.customer_360 group by risk_grade"
      ]
    },
    {
      "name": "fa33229a",
      "displayName": "Top_Customers",
      "queryLines": [
        "SELECT distinct customer_name,branch_name,total_balance from banking.gold.customer_360 ORDER BY total_balance DESC LIMIT 10"
      ]
    },
    {
      "name": "88bcdc93",
      "displayName": "Average Credit Score",
      "queryLines": [
        "SELECT avg(credit_score)as Average_credit_score from banking.gold.customer_360 "
      ]
    },
    {
      "name": "7c50fca8",
      "displayName": "Branch Deposits",
      "queryLines": [
        "Select branch_name, total_deposits from banking.gold.branch_performance order by total_deposits desc"
      ]
    },
    {
      "name": "a08ea7f9",
      "displayName": "Branch Customers",
      "queryLines": [
        "Select branch_name, total_customers from banking.gold.branch_performance order by total_customers desc"
      ]
    },
    {
      "name": "97167321",
      "displayName": "Branch Transaction",
      "queryLines": [
        "Select branch_name, total_transaction_amount from banking.gold.branch_performance order by total_transaction_amount desc"
      ]
    },
    {
      "name": "ac283a13",
      "displayName": "Gateway Transactions",
      "queryLines": [
        "Select gateway_name, sum(successful_transactions) as Successful_Transactions, sum(failed_transactions)as Failed_Transactions  from banking.gold.transaction_channel_summary group by gateway_name"
      ]
    },
    {
      "name": "2cc25caf",
      "displayName": "Device Transaction",
      "queryLines": [
        "Select device_type, sum(total_transactions) as Total_Transactions from banking.gold.transaction_channel_summary group by device_type order by Total_Transactions desc"
      ]
    },
    {
      "name": "11d000a9",
      "displayName": "Monthly Transaction Trend",
      "queryLines": [
        "Select DATE_TRUNC('month', txn_date) AS month, sum(successful_transactions) as Total_Successful_Transaction from banking.gold.transaction_channel_summary group by month order by month "
      ]
    },
    {
      "name": "f3e97b77",
      "displayName": "Successful vs Failed Transactions",
      "queryLines": [
        "select 'Successful' as status, sum(successful_transactions) as Transactions from banking.gold.transaction_channel_summary union all select 'Failed' as status, sum(failed_transactions) as Transactions from banking.gold.transaction_channel_summary"
      ]
    }
  ],
